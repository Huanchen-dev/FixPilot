# 复制为.env后填写真实值；.env不会进入Git。
DASHSCOPE_API_KEY=your_dashscope_api_key
AGENT_CHAT_MODEL=qwen3-max
AGENT_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 项目一RAG服务
RAG_AGENT_BASE_URL=http://127.0.0.1:8000
RAG_AGENT_TIMEOUT=60

# 独立Knowledge Agent A2A服务
KNOWLEDGE_AGENT_BASE_URL=http://127.0.0.1:8200
KNOWLEDGE_AGENT_TIMEOUT=90

# Streamlit访问的AgentCenter入口
AGENTCENTER_API_BASE_URL=http://127.0.0.1:8100
