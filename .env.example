# 复制为.env后填写真实值；.env不会进入Git。
DASHSCOPE_API_KEY=your_dashscope_api_key
FIXPILOT_MODEL=qwen3-max
FIXPILOT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 独立Repository Inspector Agent A2A服务
INSPECTOR_AGENT_BASE_URL=http://127.0.0.1:8200
INSPECTOR_AGENT_TIMEOUT=90

# Streamlit访问的FixPilot入口
FIXPILOT_API_BASE_URL=http://127.0.0.1:8100

# 允许只读检查的父目录；Windows多个目录用分号分隔。
# 留空时默认只允许当前项目所在的父目录。
FIXPILOT_WORKSPACE_ROOTS=
FIXPILOT_MAX_SOURCE_FILE_BYTES=262144
FIXPILOT_MAX_PROJECT_FILES=500
FIXPILOT_MAX_PROMPT_EVIDENCE_CHARS=40000
FIXPILOT_MAX_INSPECTION_STEPS=6
FIXPILOT_MAX_INSPECTION_OBSERVATION_CHARS=24000
